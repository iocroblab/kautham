<?xml version="1.0"?>

<Problem name="tiago_kitchen_tamp">

	<Robot robot="./robots/robot_instances/tiago_robot/tiago.urdf.xacro" scale="1.0">
		<KauthamName name="tiago"/>
		<Limits name="X" min="-3.0" max="3.0" />
		<Limits name="Y" min="-3.0" max="3.0" />
		<Limits name="Z" min="0.001" max="0.010" />
		<!-- <Home X="1.200 " Y="-1.200" Z="0.006" TH="1.57" WX="0.0" WY="0.0" WZ="1.0"/> -->
	</Robot>

	<!-- KITCHEN ENVIRONMENT -->
	<Obstacle obstacle="./obstacles/3D-environments/kitchen/kitchen.urdf" scale="1">
		<KauthamName name="kitchen"/>
		<Home TH="0.0" WZ="0.0" WY="0.0" WX="0.0" Z="0.0" Y="0.0" X="0.0" />
	</Obstacle>

	<Obstacle obstacle="./obstacles/3D-environments/kitchen/kitchenfloor.urdf" scale="1">
		<KauthamName name="kitchenfloor"/>
		<Home TH="0.0" WZ="0.0" WY="0.0" WX="0.0" Z="-0.001" Y="0.0" X="0.0" />
	</Obstacle>

	<!-- KITCHEN STUFF -->
	<Obstacle obstacle="./obstacles/kitchen_stuff/glass/glass.urdf" scale="1">
		<KauthamName name="glass_1"/>
		<Home TH="0.0" WZ="0.0" WY="0.0" WX="0.0" Z="0.90" Y="0.4" X="1.3" />
	</Obstacle>

	<Obstacle obstacle="./obstacles/kitchen_stuff/glass/glass.urdf" scale="1">
		<KauthamName name="glass_2"/>
		<Home TH="0.0" WZ="0.0" WY="0.0" WX="0.0" Z="0.90" Y="-0.3" X="1.4" />
	</Obstacle>

	<Obstacle obstacle="./obstacles/kitchen_stuff/cokecan/cokecan.urdf" scale="1">
		<KauthamName name="cokecan_1"/>
		<Home TH="0.0" WZ="0.0" WY="0.0" WX="0.0" Z="0.905" Y="0.0" X="1.1" />
	</Obstacle>

	<Obstacle obstacle="./obstacles/kitchen_stuff/cokecan/cokecan.urdf" scale="1">
		<KauthamName name="cokecan_2"/>
		<Home TH="0.0" WZ="0.0" WY="0.0" WX="0.0" Z="0.910" Y="-0.400" X="1.170" />
	</Obstacle>

	<Controls robot="./controls/tiago.cntr"/>

	<Planner>
		<Parameters>
			<Name>omplRRTConnect</Name>
			<Parameter name="_Max Planning Time">60</Parameter>
			<Parameter name="Range">0.1</Parameter>
			<Parameter name="_Path Drawn (0/1)">0</Parameter>
			<Parameter name="_Simplify Solution">2</Parameter>
			<Parameter name="_Incremental (0/1)">0</Parameter>
		</Parameters>
		<Queries>
			<Query>

				<RobotControl name="tiago_x" 				init="0.700" goal="0.475"/>
				<RobotControl name="tiago_y" 				init="0.300" goal="0.550"/>
				<RobotControl name="tiago_rz"				init="0.250" goal="0.500"/>

				<RobotControl name="wheel_right_joint" 		init="0.500" goal="0.500"/>
				<RobotControl name="wheel_left_joint" 		init="0.500" goal="0.500"/>

				<RobotControl name="torso_lift_joint" 		init="0.200" goal="0.900"/>

				<RobotControl name="arm_1_joint" 			init="0.020" goal="0.500"/>
				<RobotControl name="arm_2_joint" 			init="0.590" goal="0.930"/>
				<RobotControl name="arm_3_joint" 			init="0.690" goal="0.620"/>
				<RobotControl name="arm_4_joint" 			init="0.750" goal="0.570"/>
				<RobotControl name="arm_5_joint" 			init="0.150" goal="0.825"/>
				<RobotControl name="arm_6_joint" 			init="0.960" goal="0.110"/>
				<RobotControl name="arm_7_joint" 			init="0.500" goal="0.550"/>

				<RobotControl name="gripper_finger_joint" 	init="1.000" goal="1.000"/>
				
				<RobotControl name="head_1_joint" 			init="0.200" goal="0.800"/>
				<RobotControl name="head_2_joint" 			init="0.200" goal="0.800"/>

			</Query>
		</Queries>
	</Planner>

</Problem>
