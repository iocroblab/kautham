<?xml version="1.0"?>

<ControlSet>
	
	<Offset>

		<DOF robot="bigbox" name="X" value="0.5"/>
		<DOF robot="bigbox" name="Y" value="0.5"/>
		<DOF robot="bigbox" name="X1" value="0.0"/>
		<DOF robot="bigbox" name="X2" value="0.0"/>
		<DOF robot="bigbox" name="X3" value="0.5"/>

		<DOF robot="smallbox" name="X" value="0.5"/>
		<DOF robot="smallbox" name="Y" value="0.5"/>
		<DOF robot="smallbox" name="X1" value="0.0"/>
		<DOF robot="smallbox" name="X2" value="0.0"/>
		<DOF robot="smallbox" name="X3" value="0.5"/>
		
	</Offset>


	<Control name="bigbox_x" eigValue="1.0">
		<DOF robot="bigbox" name="X" value="1.0"/>
	</Control>

	<Control name="bigbox_y" eigValue="1.0">
		<DOF robot="bigbox" name="Y" value="1.0"/>
	</Control>

	<Control name="smallbox_x" eigValue="1.0">
		<DOF robot="smallbox" name="X" value="1.0"/>
	</Control>

	<Control name="smallbox_y" eigValue="1.0">
		<DOF robot="smallbox" name="Y" value="1.0"/>
	</Control>


</ControlSet>
