<?xml version="1.0"?>

<ControlSet>
	
	<Offset>

		<DOF robot="table" name="X" value="0.5"/>
		<DOF robot="table" name="Y" value="0.5"/>
		<DOF robot="table" name="X1" value="0.0"/>
		<DOF robot="table" name="X2" value="0.0"/>
		<DOF robot="table" name="X3" value="0.75"/>
		
	</Offset>


	<Control name="table_x" eigValue="1.0">
		<DOF robot="table" name="X" value="1.0"/>
	</Control>

	<Control name="table_y" eigValue="1.0">
		<DOF robot="table" name="Y" value="1.0"/>
	</Control>

	<Control name="table_x3" eigValue="1.0">
		<DOF robot="table" name="X3" value="1.0"/>
	</Control>

</ControlSet>
