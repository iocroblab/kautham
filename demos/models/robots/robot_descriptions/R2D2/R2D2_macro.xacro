<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">

<xacro:macro name="r2d2_robot" params="prefix">

    <link name="${prefix}base_link">
        <visual>
            <geometry>
                <cylinder length="0.6" radius="0.2"/>
            </geometry>
            <material name="blue">
                <color rgba="0 0 .8 1"/>
            </material>
        </visual>
        <collision>
            <geometry>
                <cylinder length="0.6" radius="0.17"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="10"/>
            <inertia ixx="1.0" ixy="0.0" ixz="0.0" iyy="1.0" iyz="0.0" izz="1.0"/>
        </inertial>
    </link>

    <joint name="${prefix}base_to_right_leg" type="fixed">
        <parent link="${prefix}base_link"/>
        <child link="${prefix}right_leg"/>
        <origin xyz="0.22 0 .25"/>
    </joint>

    <link name="${prefix}right_leg">
        <visual>
            <geometry>
                <box size="0.6 .2 .1"/>
            </geometry>
            <origin rpy="0 1.57075 0" xyz="0 0 -0.3"/>
            <material name="white">
                <color rgba="1 1 1 1"/>
            </material>
        </visual>
        <collision>
            <geometry>
                <box size="0.6 .2 .1"/>
            </geometry>
            <origin rpy="0 1.57075 0" xyz="0 0 -0.3"/>
        </collision>
        <inertial>
            <mass value="10"/>
            <origin rpy="0 1.57075 0" xyz="0 0 -0.3"/>
            <inertia ixx="1.0" ixy="0.0" ixz="0.0" iyy="1.0" iyz="0.0" izz="1.0"/>
        </inertial>
    </link>

    <joint name="${prefix}right_base_joint" type="fixed">
        <parent link="${prefix}right_leg"/>
        <child link="${prefix}right_base"/>
        <origin xyz="0 0 -0.6"/>
    </joint>

    <link name="${prefix}right_base">
        <visual>
            <geometry>
                <box size=".1 0.4 .1"/>
            </geometry>
            <material name="white"/>
        </visual>
        <collision>
            <geometry>
                <box size=".1 0.4 .1"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="10"/>
            <inertia ixx="1.0" ixy="0.0" ixz="0.0" iyy="1.0" iyz="0.0" izz="1.0"/>
        </inertial>
    </link>

    <joint name="${prefix}right_front_wheel_joint" type="continuous">
        <axis xyz="0 0 1"/>
        <parent link="${prefix}right_base"/>
        <child link="${prefix}right_front_wheel"/>
        <origin rpy="0 1.57075 0" xyz="0 0.133333333333 -0.085"/>
        <limit effort="100" velocity="100"/>
        <joint_properties damping="0.0" friction="0.0"/>
    </joint>

    <link name="${prefix}right_front_wheel">
        <visual>
            <geometry>
                <cylinder length=".1" radius="0.035"/>
            </geometry>
            <material name="black">
                <color rgba="0.5 0.5 0.5 1"/>
            </material>
        </visual>
        <collision>
            <geometry>
                <cylinder length=".1" radius="0.035"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="1"/>
            <inertia ixx="1.0" ixy="0.0" ixz="0.0" iyy="1.0" iyz="0.0" izz="1.0"/>
        </inertial>
    </link>



  <link name="${prefix}right_back_wheel">
    <visual>
      <geometry>
        <cylinder length=".1" radius="0.035"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length=".1" radius="0.035"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1"/>
      <inertia ixx="1.0" ixy="0.0" ixz="0.0" iyy="1.0" iyz="0.0" izz="1.0"/>
    </inertial>
  </link>

  <joint name="${prefix}right_back_wheel_joint" type="continuous">
    <axis xyz="0 0 1"/>
    <parent link="${prefix}right_base"/>
    <child link="${prefix}right_back_wheel"/>
    <origin rpy="0 1.57075 0" xyz="0 -0.133333333333 -0.085"/>
    <limit effort="100" velocity="100"/>
    <joint_properties damping="0.0" friction="0.0"/>
  </joint>

  <link name="${prefix}left_leg">
    <visual>
      <geometry>
        <box size="0.6 .2 .1"/>
      </geometry>
      <origin rpy="0 1.57075 0" xyz="0 0 -0.3"/>
      <material name="white"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.6 .2 .1"/>
      </geometry>
      <origin rpy="0 1.57075 0" xyz="0 0 -0.3"/>
    </collision>
    <inertial>
      <mass value="10"/>
      <inertia ixx="1.0" ixy="0.0" ixz="0.0" iyy="1.0" iyz="0.0" izz="1.0"/>
      <origin rpy="0 1.57075 0" xyz="0 0 -0.3"/>
    </inertial>
  </link>

  <joint name="${prefix}base_to_left_leg" type="fixed">
    <parent link="${prefix}base_link"/>
    <child link="${prefix}left_leg"/>
    <origin xyz="-0.22 0 .25"/>
  </joint>

  <link name="${prefix}left_base">
    <visual>
      <geometry>
        <box size=".1 0.4 .1"/>
      </geometry>
      <material name="white"/>
    </visual>
    <collision>
      <geometry>
        <box size=".1 0.4 .1"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="10"/>
      <inertia ixx="1.0" ixy="0.0" ixz="0.0" iyy="1.0" iyz="0.0" izz="1.0"/>
    </inertial>
  </link>

  <joint name="${prefix}left_base_joint" type="fixed">
    <parent link="${prefix}left_leg"/>
    <child link="${prefix}left_base"/>
    <origin xyz="0 0 -0.6"/>
  </joint>

  <link name="${prefix}left_front_wheel">
    <visual>
      <geometry>
        <cylinder length=".1" radius="0.035"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length=".1" radius="0.035"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1"/>
      <inertia ixx="1.0" ixy="0.0" ixz="0.0" iyy="1.0" iyz="0.0" izz="1.0"/>
    </inertial>
  </link>

  <joint name="${prefix}left_front_wheel_joint" type="continuous">
    <axis xyz="0 0 1"/>
    <parent link="${prefix}left_base"/>
    <child link="${prefix}left_front_wheel"/>
    <origin rpy="0 1.57075 0" xyz="0 0.133333333333 -0.085"/>
    <limit effort="100" velocity="100"/>
    <joint_properties damping="0.0" friction="0.0"/>
  </joint>

  <link name="${prefix}left_back_wheel">
    <visual>
      <geometry>
        <cylinder length=".1" radius="0.035"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length=".1" radius="0.035"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1"/>
      <inertia ixx="1.0" ixy="0.0" ixz="0.0" iyy="1.0" iyz="0.0" izz="1.0"/>
    </inertial>
  </link>

  <joint name="${prefix}left_back_wheel_joint" type="continuous">
    <axis xyz="0 0 1"/>
    <parent link="${prefix}left_base"/>
    <child link="${prefix}left_back_wheel"/>
    <origin rpy="0 1.57075 0" xyz="0 -0.133333333333 -0.085"/>
    <limit effort="100" velocity="100"/>
    <joint_properties damping="0.0" friction="0.0"/>
  </joint>

  <joint name="${prefix}gripper_extension" type="prismatic">
    <axis xyz="1 0 0"/>
    <parent link="${prefix}base_link"/>
    <child link="${prefix}gripper_pole"/>
    <limit effort="1000.0" lower="-0.38" upper="0" velocity="0.5"/>
    <origin rpy="0 0 1.57075" xyz="0 0.19 .2"/>
  </joint>

  <link name="${prefix}gripper_pole">
    <visual>
      <geometry>
        <cylinder length="0.2" radius=".01"/>
      </geometry>
      <origin rpy="0 1.57075 0 " xyz="0.1 0 0"/>
      <material name="Gray">
        <color rgba=".7 .7 .7 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.2" radius=".01"/>
      </geometry>
      <origin rpy="0 1.57075 0 " xyz="0.1 0 0"/>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="1.0" ixy="0.0" ixz="0.0" iyy="1.0" iyz="0.0" izz="1.0"/>
    </inertial>
  </link>

  <joint name="${prefix}left_gripper_joint" type="revolute">
    <axis xyz="0 0 1"/>
    <limit effort="1000.0" lower="0.0" upper="0.548" velocity="0.5"/>
    <origin rpy="0 0 0" xyz="0.2 0.02 0"/>
    <parent link="${prefix}gripper_pole"/>
    <child link="${prefix}left_gripper"/>
  </joint>

  <link name="${prefix}left_gripper">
    <visual>
      <origin rpy="0.0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="./../../robot_descriptions/R2D2/meshes/l_finger.stl"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <mesh filename="./../../robot_descriptions/R2D2/meshes/l_finger.stl"/>
      </geometry>
      <origin rpy="0.0 0 0" xyz="0 0 0"/>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="1.0" ixy="0.0" ixz="0.0" iyy="1.0" iyz="0.0" izz="1.0"/>
    </inertial>
  </link>

  <joint name="${prefix}left_tip_joint" type="fixed">
    <parent link="${prefix}left_gripper"/>
    <child link="${prefix}left_tip"/>
  </joint>

  <link name="${prefix}left_tip">
    <visual>
      <origin rpy="0.0 0 0" xyz="0.09137 0.00495 0"/>
      <geometry>
        <mesh filename="./../../robot_descriptions/R2D2/meshes/l_finger_tip.stl"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <mesh filename="./../../robot_descriptions/R2D2/meshes/l_finger_tip.stl"/>
      </geometry>
      <origin rpy="0.0 0 0" xyz="0.09137 0.00495 0"/>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="1.0" ixy="0.0" ixz="0.0" iyy="1.0" iyz="0.0" izz="1.0"/>
    </inertial>
  </link>

  <joint name="${prefix}right_gripper_joint" type="revolute">
    <axis xyz="0 0 -1"/>
    <limit effort="1000.0" lower="0.0" upper="0.548" velocity="0.5"/>
    <origin rpy="0 0 0" xyz="0.2 -0.02 0"/>
    <parent link="${prefix}gripper_pole"/>
    <child link="${prefix}right_gripper"/>
  </joint>

  <link name="${prefix}right_gripper">
    <visual>
      <origin rpy="-3.1415 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="./../../robot_descriptions/R2D2/meshes/l_finger.stl"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <mesh filename="./../../robot_descriptions/R2D2/meshes/l_finger.stl"/>
      </geometry>
      <origin rpy="-3.1415 0 0" xyz="0 0 0"/>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="1.0" ixy="0.0" ixz="0.0" iyy="1.0" iyz="0.0" izz="1.0"/>
    </inertial>
  </link>

  <joint name="${prefix}right_tip_joint" type="fixed">
    <parent link="${prefix}right_gripper"/>
    <child link="${prefix}right_tip"/>
  </joint>

  <link name="${prefix}right_tip">
    <visual>
      <origin rpy="-3.1415 0 0" xyz="0.09137 0.00495 0"/>
      <geometry>
        <mesh filename="./../../robot_descriptions/R2D2/meshes/l_finger_tip.stl"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <mesh filename="./../../robot_descriptions/R2D2/meshes/l_finger_tip.stl"/>
      </geometry>
      <origin rpy="-3.1415 0 0" xyz="0.09137 0.00495 0"/>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="1.0" ixy="0.0" ixz="0.0" iyy="1.0" iyz="0.0" izz="1.0"/>
    </inertial>
  </link>

  <link name="${prefix}head">
    <visual>
      <geometry>
        <sphere radius="0.16"/>
      </geometry>
      <material name="white"/>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.16"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="10"/>
      <inertia ixx="1.0" ixy="0.0" ixz="0.0" iyy="1.0" iyz="0.0" izz="1.0"/>
    </inertial>
  </link>

  <joint name="${prefix}head_swivel" type="continuous">
    <parent link="${prefix}base_link"/>
    <child link="${prefix}head"/>
    <axis xyz="0 0 1"/>
    <origin xyz="0 0 0.3"/>
    <limit effort="1000.0" lower="-0.38" upper="0" velocity="0.5"/>
  </joint>

  <link name="${prefix}box">
    <visual>
      <geometry>
        <box size=".08 .08 .08"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <geometry>
        <box size=".08 .08 .08"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1"/>
      <inertia ixx="1.0" ixy="0.0" ixz="0.0" iyy="1.0" iyz="0.0" izz="1.0"/>
    </inertial>
  </link>

  <joint name="${prefix}tobox" type="fixed">
    <parent link="${prefix}head"/>
    <child link="${prefix}box"/>
    <origin xyz="0 0.1214 0.1214"/>
  </joint>
</xacro:macro>

</robot>