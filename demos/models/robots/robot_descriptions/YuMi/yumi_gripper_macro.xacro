<?xml version="1.0"?>
<robot name="yumi_gripper" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:arg name="yumi_gripper_description" default="./../../robot_descriptions/YuMi"/>

    <!-- Include Utilities -->
    <xacro:include filename="$(arg yumi_gripper_description)/utilities.xacro" />
    <!-- <xacro:include filename="$(arg yumi_gripper_description)/materials.xacro" /> -->

    <!-- some constants -->
    <xacro:property name="joint_damping" value="0.5" />
    <xacro:property name="max_effort" value="300"/>

    <xacro:macro name="yumi_gripper" params="parent prefix *origin">

        <!--joint between {parent} and base-->
        <xacro:if value="${parent != ''}">
            <joint name="${prefix}_fixed_joint" type="fixed">
                <xacro:insert_block name="origin" />
                <parent link="${parent}" />
                <child link="${prefix}_base" />
            </joint>
        </xacro:if>

        <link name="${prefix}_base">
            <visual>
                <origin xyz="0 0 0.0" rpy="0 0 0"/>
                <geometry>
                    <mesh filename="$(arg yumi_gripper_description)/meshes/gripper/base.stl"/>
                </geometry>
                <material name="Light_Grey"/>
            </visual>
            <collision>
                <origin xyz="0 0 0.0" rpy="0 0 0"/>
                <geometry>
                    <mesh filename="$(arg yumi_gripper_description)/meshes/gripper/coarse/base.stl"/>
                </geometry>
                <material name="Light_Grey"/>
            </collision>
            <inertial>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <mass value="0.2"/>
                <inertia ixx="0.0001"  ixy="0"  ixz="0" iyy="0.0001" iyz="0" izz="0.0001" />
            </inertial>
        </link>

        <!-- joint between base and right finger -->
        <joint name="${prefix}_joint" type="prismatic">
            <parent link="${prefix}_base"/>
            <child link="${prefix}_finger_r"/>
            <origin xyz="0 -0.0065 0.085" rpy="0 0 0"/>
            <axis xyz="-1 0 0"/>
            <limit lower="0" upper="0.025" effort="${max_effort}" velocity="0.02" />
            <dynamics damping="${joint_damping}"/>
        </joint>

        <link name="${prefix}_finger_r">
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <mesh filename="$(arg yumi_gripper_description)/meshes/gripper/finger.stl"/>
                </geometry>
                <material name="Grey"/>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <mesh filename="$(arg yumi_gripper_description)/meshes/gripper/coarse/finger.stl"/>
                </geometry>
                <material name="Grey"/>
            </collision>
            <inertial>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <mass value="0.01"/>
                <inertia ixx="0.000001"  ixy="0"  ixz="0" iyy="0.000001" iyz="0" izz="0.000001" />
            </inertial>
        </link>

        <!-- joint between base and left finger -->
        <joint name="${prefix}_joint_m" type="prismatic">
            <parent link="${prefix}_base"/>
            <child link="${prefix}_finger_l"/>
            <origin xyz="0 0.0065 0.085" rpy="0 0 ${PI}"/>
            <axis xyz="-1 0 0"/>
            <limit lower="0" upper="0.025" effort="${max_effort}" velocity="0.02" />
            <dynamics damping="${joint_damping}"/>
            <mimic joint="${prefix}_joint"/>
        </joint>

        <link name="${prefix}_finger_l">
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <mesh filename="$(arg yumi_gripper_description)/meshes/gripper/finger.stl"/>
                </geometry>
                <material name="Grey"/>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <mesh filename="$(arg yumi_gripper_description)/meshes/gripper/coarse/finger.stl"/>
                </geometry>
                <material name="Grey"/>
            </collision>
            <inertial>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <mass value="0.01"/>
                <inertia ixx="0.000001"  ixy="0"  ixz="0" iyy="0.000001" iyz="0" izz="0.000001" />
            </inertial>
        </link>

  </xacro:macro>

</robot>
