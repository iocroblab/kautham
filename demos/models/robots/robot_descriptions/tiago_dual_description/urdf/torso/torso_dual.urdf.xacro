<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:arg name="from_torso_dual_2_pal_urdf_utils_path" default="./../../../../robot_descriptions/pal_urdf_utils"/>
  <xacro:arg name="tiago_dual_description" default="./../../robot_descriptions/tiago_dual_description"/>
  <xacro:arg name="tiago_single_description" default="./../../robot_descriptions/tiago_robot"/>

  <!-- PROPERTIES -->
  <xacro:property name="torso_max_vel" value="0.07" />
  <xacro:property name="torso_eps" value="0.02" />

  <!--INCLUDES -->
  <xacro:include filename="$(arg from_torso_dual_2_pal_urdf_utils_path)/urdf/deg_to_rad.urdf.xacro" />

  <!-- MACRO DEFINITION -->
  <xacro:macro name="tiago_dual_torso" params="name parent *origin has_screen">

    <!-- Bottom fixed part of column -->
    <link name="${name}_fixed_link">
      <inertial>
        <origin xyz="0.02435 -0.00464 0.15900" rpy="0.00000 0.00000 0.00000"/>
        <mass value="14.01360"/>
        <inertia ixx="0.38341100000" ixy="0.00036400000" ixz="-0.02438900000" iyy="0.40577300000" iyz="-0.00078200000" izz="0.07699800000"/>
      </inertial>
      <visual>
        <origin rpy="0 0 0" xyz="0 0 0" />
        <geometry>
          <mesh filename="$(arg tiago_dual_description)/meshes/torso/torso_fix.stl" scale="1 1 1"/>
        </geometry>
        <material name="LightGrey"/>
      </visual>
      <collision>
        <origin rpy="0 0 0" xyz="0.085 0.0 0.02" />
        <geometry>
          <box size="0.4 0.265 0.057"/>
        </geometry>
      </collision>
      <collision>
        <origin rpy="0 0 0" xyz="0 0 0.05" />
        <geometry>
          <box size="0.25 0.265 0.052"/>
        </geometry>
      </collision>
    </link>

    <joint name="${name}_fixed_joint" type="fixed">
      <xacro:insert_block name="origin"/>
      <parent link="${parent}" />
      <child link="${name}_fixed_link" />
      <axis xyz="0 0 0" />
    </joint>

    <!-- Middle extending  -->
    <link name="${name}_fixed_column_link">
      <inertial>
        <origin rpy="0 0 0" xyz="0 0 0" />
        <mass value="0.01" />
        <inertia ixx="0.000001" ixy="0" ixz="0" iyy="0.000001" iyz="0" izz="0.000001" />
      </inertial>
      <visual>
        <origin rpy="0 0 0" xyz="0 0 0.275" />
        <geometry>
          <box size="0.18 0.2 0.55"/>
        </geometry>
        <material name="DarkGrey"/>
      </visual>
      <!-- <collision>
        <origin rpy="0 0 0" xyz="0 0 0.275" />
        <geometry>
          <box size="0.232 0.26 0.45"/>
        </geometry>
        <material name="DarkGrey"/>
      </collision> -->
    </link>
    <gazebo reference="${name}_fixed_column_link">
      <material>Gazebo/DarkGrey</material>
    </gazebo>

    <joint name="${name}_fixed_column_joint" type="fixed">
      <xacro:insert_block name="origin"/>
      <parent link="${parent}" />
      <child link="${name}_fixed_column_link" />
      <axis xyz="0 0 0" />
    </joint>

    <link name="${name}_lift_link">
      <inertial>
        <origin xyz="0.04361 -0.00116 -0.17334" rpy="0.00000 0.00000 0.00000"/>
        <mass value="9.594213"/>
        <!-- <inertia ixx="0.24487000000" ixy="-0.00145600000" ixz="-0.00974200000" iyy="0.24926900000" iyz="0.00828100000" izz="0.09039500000"/> -->
        <inertia ixx="0.326395" ixy="-0.000844" ixz="-0.018905" iyy="0.235332" iyz="0.009042" izz="0.176168"/>
      </inertial>
      <!-- Lifting body -->
      <xacro:if value="${has_screen}">
        <visual>
          <origin rpy="0 0 0" xyz="0 0 0" />
          <geometry>
            <mesh filename="$(arg tiago_dual_description)/meshes/torso/torso_lift_dual_arm_with_screen.stl" scale="1 1 1"/>
          </geometry>
          <material name="White"/>
        </visual>
        <collision>
          <origin rpy="0 0 0" xyz="0 0 0" />
          <geometry>
            <mesh filename="$(arg tiago_dual_description)/meshes/torso/torso_lift_dual_arm_with_screen.dae" scale="1 1 1"/>
          </geometry>
          <material name="LightGrey"/>
        </collision>
      </xacro:if>
      <xacro:unless value="${has_screen}">
        <visual>
          <origin rpy="0 0 0" xyz="0 0 0" />
          <geometry>
            <mesh filename="$(arg tiago_dual_description)/meshes/torso/torso_lift_dual_arm.stl" scale="1 1 1"/>
          </geometry>
          <material name="White"/>
        </visual>
        <collision>
          <origin rpy="0 0 0" xyz="0 0 0" />
          <geometry>
            <mesh filename="$(arg tiago_single_description)/meshes/torso/torso_lift_collision_core.dae" scale="1 1 1"/>
          </geometry>
          <material name="LightGrey"/>
        </collision>
        <!-- left shoulder collision-->
        <collision>
          <origin rpy="0 0 0" xyz="-0.131 0.17 -0.02556" />
          <geometry>
            <mesh filename="$(arg tiago_single_description)/meshes/torso/torso_lift_collision_shoulder.dae" scale="1 1 1"/>
          </geometry>
          <material name="LightGrey"/>
        </collision>
        <!-- right shoulder collision-->
        <collision>
          <origin rpy="0 0 0" xyz="-0.131 -0.19 -0.02556" />
          <geometry>
            <mesh filename="$(arg tiago_single_description)/meshes/torso/torso_lift_collision_shoulder.dae" scale="1 1 1"/>
          </geometry>
          <material name="LightGrey"/>
        </collision>
        <collision>
          <origin rpy="0 0 0" xyz="0 0 0" />
          <geometry>
            <mesh filename="$(arg tiago_single_description)/meshes/torso/torso_lift_collision_neck.dae" scale="1 1 1"/>
          </geometry>
          <material name="LightGrey"/>
        </collision>
      </xacro:unless>
    </link>

    <joint name="${name}_lift_joint" type="prismatic">
      <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.597" />
      <parent link="${name}_fixed_link" />
      <child link="${name}_lift_link" />
      <axis xyz="0 0 1" />
      <limit effort="2000" lower="0" upper="0.35" velocity="${torso_max_vel}" />
      <calibration rising="0.0" />
      <dynamics damping="1000" />
      <safety_controller k_position="20" k_velocity="20" soft_lower_limit="0.0" soft_upper_limit="0.35" />
    </joint>

  </xacro:macro>

</robot>
